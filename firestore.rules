rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Both household accounts can read everything -- Rochelle's access is
    // meant to be full (the whole Goal hierarchy, every domain), just
    // read-only. Writes are gated separately by isOwner().
    function isAllowed() {
      return request.auth != null &&
        request.auth.token.email in [
          'tannerwesgardner@gmail.com',
          'rochelleygardner@gmail.com'
        ];
    }

    // Secretary is Tanner's own head-of-household layer -- only his account
    // may write. This is the one place that role is decided; keep it in
    // sync with isOwnerEmail() in src/constants.js by hand.
    function isOwner() {
      return isAllowed() && request.auth.token.email == 'tannerwesgardner@gmail.com';
    }

    // Shared vocabularies -- kept as functions so the entity schemas below
    // and their event-log counterparts can't quietly drift apart.
    function domainValues() {
      return [
        'finances', 'material', 'teacher', 'tech-admin', 'career', 'projects',
        'collab', 'cleaning', 'repair', 'planning', 'weekly-meeting', 'reading',
        'writing', 'contemplation', 'ecology-practices'
      ];
    }

    function tierValues() {
      return ['yearly', 'quarterly', 'monthly', 'weekly'];
    }

    function statusValues() {
      return ['active', 'done', 'dropped'];
    }

    function initiatorValues() {
      return ['me', 'wife'];
    }

    function familyScopeValues() {
      return ['personal', 'touches-family'];
    }

    function consentStatusValues() {
      return ['pending', 'granted', 'declined'];
    }

    // Content-type categories are domain-scoped, not shared -- kept in sync
    // by hand with src/constants.js' DEFAULT_ROUTING_TABLE. Every id carries
    // its domain's prefix (fin-, mat-, tch-, ...), which contentTypeDomainPrefix()
    // below uses to enforce that a Session's contentType actually belongs to
    // its own domain, not just any real category.
    function contentTypeValues() {
      return [
        'fin-scheduling', 'fin-execution', 'fin-review', 'fin-research', 'fin-capture', 'fin-comm',
        'mat-capture', 'mat-scheduling', 'mat-research', 'mat-inventory', 'mat-deprovision', 'mat-comm',
        'tch-dialogic', 'tch-teaching-prep', 'tch-reading', 'tch-curriculum', 'tch-scheduling', 'tch-reference',
        'adm-execution', 'adm-scheduling', 'adm-inventory', 'adm-capture', 'adm-comm',
        'car-scheduling', 'car-development', 'car-execution', 'car-comm', 'car-reflection',
        'prj-capture', 'prj-planning', 'prj-scheduling', 'prj-execution', 'prj-writeup',
        'col-dialogic', 'col-scheduling', 'col-consent', 'col-execution', 'col-comm',
        'cln-scheduling', 'cln-execution', 'cln-capture',
        'rep-capture', 'rep-scheduling', 'rep-research', 'rep-execution', 'rep-comm',
        'pln-systems', 'pln-scheduling', 'pln-reflection', 'pln-capture',
        'wkm-recap', 'wkm-glance', 'wkm-prep', 'wkm-followup',
        'rdg-engagement', 'rdg-scheduling', 'rdg-reference', 'rdg-reflection', 'rdg-capture',
        'wrt-drafting', 'wrt-research', 'wrt-scheduling', 'wrt-capture',
        'ctm-reflection', 'ctm-reading', 'ctm-scheduling', 'ctm-capture',
        'eco-execution', 'eco-scheduling', 'eco-capture', 'eco-reflection'
      ];
    }

    function contentTypeDomainPrefix(domain) {
      return {
        'finances': 'fin-', 'material': 'mat-', 'teacher': 'tch-', 'tech-admin': 'adm-',
        'career': 'car-', 'projects': 'prj-', 'collab': 'col-', 'cleaning': 'cln-',
        'repair': 'rep-', 'planning': 'pln-', 'weekly-meeting': 'wkm-', 'reading': 'rdg-',
        'writing': 'wrt-', 'contemplation': 'ctm-', 'ecology-practices': 'eco-'
      }[domain];
    }

    function entityTypeValues() {
      return ['goal', 'project', 'plan', 'session', 'task'];
    }

    function captureStatusValues() {
      return ['pending-triage', 'holding', 'placed', 'drift', 'discarded'];
    }

    // Every entity may carry secondaryDomains alongside its required primary
    // domain -- not deep-validated per element (same looseness already used
    // for sessionIds/taskIds), just checked to be a list when present.
    function hasValidSecondaryDomains(d) {
      return !('secondaryDomains' in d) || d.secondaryDomains is list;
    }

    function isValidGoal(d) {
      return d.title is string && d.title.size() > 0 &&
        d.tier in tierValues() &&
        d.domain in domainValues() &&
        hasValidSecondaryDomains(d) &&
        d.owner in ['tanner', 'rochelle'] &&
        (!('parentGoalId' in d) || d.parentGoalId == null || d.parentGoalId is string) &&
        d.status in statusValues() &&
        d.createdAt is number &&
        d.updatedAt is number;
    }

    function isValidProject(d) {
      return d.title is string && d.title.size() > 0 &&
        d.domain in domainValues() &&
        hasValidSecondaryDomains(d) &&
        d.initiator in initiatorValues() &&
        d.familyScope in familyScopeValues() &&
        d.status in statusValues() &&
        (!('consentStatus' in d) || d.consentStatus in consentStatusValues()) &&
        d.createdAt is number &&
        d.updatedAt is number;
    }

    // parentType/parentId are optional together -- either both omitted/null
    // (an ungrounded Plan, logged before a Goal/Project exists for it to
    // serve) or both set. This is the mechanism for groundwork that later
    // gets retroactively attached once a Goal emerges from it.
    function isValidPlan(d) {
      return d.title is string && d.title.size() > 0 &&
        ((
          (!('parentType' in d) || d.parentType == null) &&
          (!('parentId' in d) || d.parentId == null)
        ) || (
          d.parentType in ['goal', 'project'] &&
          d.parentId is string && d.parentId.size() > 0
        )) &&
        d.domain in domainValues() &&
        hasValidSecondaryDomains(d) &&
        (!('sessionIds' in d) || d.sessionIds is list) &&
        d.status in statusValues() &&
        d.createdAt is number &&
        d.updatedAt is number;
    }

    function isValidSession(d) {
      return d.title is string && d.title.size() > 0 &&
        d.planId is string && d.planId.size() > 0 &&
        d.domain in domainValues() &&
        hasValidSecondaryDomains(d) &&
        d.contentType in contentTypeValues() &&
        d.contentType.matches(contentTypeDomainPrefix(d.domain) + '.*') &&
        d.toolLocation is string &&
        (!('taskIds' in d) || d.taskIds is list) &&
        (!('targetDay' in d) || d.targetDay is string) &&
        d.done is bool &&
        d.createdAt is number &&
        d.updatedAt is number;
    }

    // sessionId is optional -- a bare Task can stand alone (most quick-adds
    // won't have a Session picked out yet) and gets attached to one later.
    function isValidTask(d) {
      return d.title is string && d.title.size() > 0 &&
        (!('sessionId' in d) || d.sessionId == null || (d.sessionId is string && d.sessionId.size() > 0)) &&
        (!('domain' in d) || d.domain in domainValues()) &&
        hasValidSecondaryDomains(d) &&
        d.done is bool &&
        (!('date' in d) || d.date is string) &&
        d.createdAt is number &&
        d.updatedAt is number;
    }

    // Append-only log of lifecycle transitions across every entity type,
    // written alongside every save/delete so the Goal rollup report has
    // something to pull from without a scheduled snapshot job.
    function isValidEvent(d) {
      return d.entityType in entityTypeValues() &&
        d.entityId is string && d.entityId.size() > 0 &&
        (!('domain' in d) || d.domain in domainValues()) &&
        d.to is string &&
        (d.from == null || d.from is string) &&
        d.at is number;
    }

    // Captures carry an AI-drafted triageDraft (see functions/index.js's
    // triageCapture) whose internal shape is intentionally left loose here --
    // it's a draft only ever committed client-side after Tanner accepts it,
    // never trusted as-is to place an entity.
    function isValidCapture(d) {
      return d.status in captureStatusValues() &&
        (!('rawText' in d) || d.rawText is string) &&
        (!('rawImageURL' in d) || d.rawImageURL is string) &&
        (!('triageDraft' in d) || d.triageDraft is map) &&
        d.createdAt is number;
    }

    // config/routingTable and config/domains hold the editable copies of
    // DEFAULT_ROUTING_TABLE / DEFAULT_DOMAINS from src/constants.js --
    // Settings can rewrite either without a code change.
    function isValidConfig(d) {
      return d.entries is list;
    }

    match /goals/{id} {
      allow read: if isAllowed();
      allow delete: if isOwner();
      allow create, update: if isOwner() && isValidGoal(request.resource.data);
    }

    match /projects/{id} {
      allow read: if isAllowed();
      allow delete: if isOwner();
      allow create, update: if isOwner() && isValidProject(request.resource.data);
    }

    match /plans/{id} {
      allow read: if isAllowed();
      allow delete: if isOwner();
      allow create, update: if isOwner() && isValidPlan(request.resource.data);
    }

    match /sessions/{id} {
      allow read: if isAllowed();
      allow delete: if isOwner();
      allow create, update: if isOwner() && isValidSession(request.resource.data);
    }

    match /tasks/{id} {
      allow read: if isAllowed();
      allow delete: if isOwner();
      allow create, update: if isOwner() && isValidTask(request.resource.data);
    }

    match /events/{id} {
      allow read: if isAllowed();
      allow create: if isOwner() && isValidEvent(request.resource.data);
    }

    match /captures/{id} {
      allow read: if isAllowed();
      allow delete: if isOwner();
      allow create, update: if isOwner() && isValidCapture(request.resource.data);
    }

    match /config/{id} {
      allow read: if isAllowed();
      allow create, update: if isOwner() && isValidConfig(request.resource.data);
    }
  }
}

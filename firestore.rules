rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Both household accounts have identical read/write access -- there is
    // no owner/viewer split anymore (the redesign explicitly removes it).
    // The two-account allow-list itself stays: still nobody else can sign
    // in and touch this data.
    function isAllowed() {
      return request.auth != null &&
        request.auth.token.email in [
          'tannerwesgardner@gmail.com',
          'rochelleygardner@gmail.com'
        ];
    }

    // Shared vocabularies -- kept as functions so the entity schemas below
    // and their event-log counterparts can't quietly drift apart.
    function domainValues() {
      return ['creative', 'vocation', 'education', 'head-of-household', 'projects', 'practices', 'goals'];
    }

    function kindTypeValues() {
      return ['project', 'goal', 'practice'];
    }

    function itemTypeValues() {
      return ['task', 'session', 'prep', 'errand', 'other'];
    }

    function kindStatusValues() {
      return ['not-started', 'queued', 'in-progress', 'almost-done', 'done'];
    }

    function initiatorValues() {
      return ['me', 'wife'];
    }

    function familyScopeValues() {
      return ['personal', 'touches-family'];
    }

    function consentStatusValues() {
      return ['pending', 'granted', 'declined'];
    }

    function createdViaValues() {
      return ['add-form', 'capture', 'secretary-chat', 'weekly-import'];
    }

    function entityTypeValues() {
      return ['kind', 'item', 'discipline'];
    }

    function captureStatusValues() {
      return ['triaging', 'proposed', 'discarded'];
    }

    function pendingOpTypeValues() {
      return ['create-kind', 'create-item', 'update-kind', 'update-item'];
    }

    function pendingOpStatusValues() {
      return ['pending', 'approved', 'discarded'];
    }

    // A handful of fields are shared, loosely-typed lists across both Kind
    // and Item (secondaryDomains, resources, tags) -- not deep-validated
    // per element, same looseness the prior rework used for sessionIds/
    // taskIds: checked to be a list when present, nothing more.
    function isOptionalList(d, key) {
      return !(key in d) || d[key] is list;
    }

    // timing is a nested map (targetDay/time/dueDate/floating/milestones)
    // left loose here on purpose -- it's meant to be tentative/incomplete
    // at creation and fleshed out later (Plans, Workspace), so the schema
    // shouldn't force a shape on it prematurely.
    function isValidTiming(d) {
      return !('timing' in d) || d.timing == null || d.timing is map;
    }

    // Kind: Project / Goal / Practice -- the anchor entity. parentKindId
    // enables Goal-tier nesting and Project/sub-Project hierarchies without
    // a fixed tier field; status drives the Plans kanban.
    function isValidKind(d) {
      return d.title is string && d.title.size() > 0 &&
        d.kindType in kindTypeValues() &&
        d.domain in domainValues() &&
        isOptionalList(d, 'secondaryDomains') &&
        isOptionalList(d, 'resources') &&
        isOptionalList(d, 'tags') &&
        (!('parentKindId' in d) || d.parentKindId == null || d.parentKindId is string) &&
        d.status in kindStatusValues() &&
        isValidTiming(d) &&
        (!('initiator' in d) || d.initiator in initiatorValues()) &&
        (!('familyScope' in d) || d.familyScope in familyScopeValues()) &&
        (!('consentStatus' in d) || d.consentStatus in consentStatusValues()) &&
        (!('retro' in d) || d.retro is bool) &&
        (!('createdVia' in d) || d.createdVia in createdViaValues()) &&
        d.createdAt is number &&
        d.updatedAt is number;
    }

    // Item: Task / Session / Prep / Errand / Other -- may float unattached
    // (parentKindId null) or attach to a Kind. isRecurringPracticeItem +
    // practiceHabitId are the sync point with practiceHabits (see
    // src/lib/graph.js's practice-item helpers for the write contract).
    function isValidItem(d) {
      return d.title is string && d.title.size() > 0 &&
        d.itemType in itemTypeValues() &&
        d.domain in domainValues() &&
        isOptionalList(d, 'secondaryDomains') &&
        isOptionalList(d, 'resources') &&
        isOptionalList(d, 'tags') &&
        (!('parentKindId' in d) || d.parentKindId == null || d.parentKindId is string) &&
        isValidTiming(d) &&
        d.done is bool &&
        (!('completedAt' in d) || d.completedAt == null || d.completedAt is number) &&
        (!('isRecurringPracticeItem' in d) || d.isRecurringPracticeItem is bool) &&
        (!('practiceHabitId' in d) || d.practiceHabitId == null || d.practiceHabitId is string) &&
        (!('retro' in d) || d.retro is bool) &&
        (!('createdVia' in d) || d.createdVia in createdViaValues()) &&
        d.createdAt is number &&
        d.updatedAt is number;
    }

    // practiceHabits are the habit *definition* only -- never a completion
    // record. A given habit+day's completion lives on exactly one Item
    // (isRecurringPracticeItem + practiceHabitId above), not here.
    function isValidPracticeHabit(d) {
      return d.title is string && d.title.size() > 0 &&
        d.categoryId is string && d.categoryId.size() > 0 &&
        (!('frequency' in d) || d.frequency is map) &&
        isOptionalList(d, 'resources') &&
        isOptionalList(d, 'tags') &&
        (!('active' in d) || d.active is bool) &&
        d.createdAt is number;
    }

    // A discipline is the inverse of a practice habit: not something you do
    // and check off, but a bad habit you're actively eliminating. Streak
    // math (days since startedAt, next milestone) is computed client-side
    // from startedAt + milestones, not stored -- milestones is left loose
    // (a list) the same way Kind.timing.milestones is, since it's a small
    // per-habit array with no cross-entity meaning to enforce.
    function isValidDiscipline(d) {
      return d.title is string && d.title.size() > 0 &&
        d.domain in domainValues() &&
        isOptionalList(d, 'resources') &&
        isOptionalList(d, 'tags') &&
        (!('milestones' in d) || d.milestones is list) &&
        (!('focused' in d) || d.focused is bool) &&
        (!('resolved' in d) || d.resolved is bool) &&
        (!('startedAt' in d) || d.startedAt is number) &&
        d.createdAt is number &&
        d.updatedAt is number;
    }

    // Append-only log of lifecycle transitions across Kinds/Items, written
    // alongside every save/delete so Log (§8) and progress rollups have
    // something to reconstruct from without a scheduled snapshot job.
    function isValidEvent(d) {
      return d.entityType in entityTypeValues() &&
        d.entityId is string && d.entityId.size() > 0 &&
        (!('domain' in d) || d.domain in domainValues()) &&
        d.to is string &&
        (d.from == null || d.from is string) &&
        d.at is number;
    }

    // Captures are just the raw intake record now (text or photo) -- triage
    // always drafts a pendingOperation for review rather than writing a
    // Kind/Item directly, so there's no triageDraft/placement shape to
    // validate here anymore.
    function isValidCapture(d) {
      return d.status in captureStatusValues() &&
        (!('rawText' in d) || d.rawText is string) &&
        (!('rawImageURL' in d) || d.rawImageURL is string) &&
        d.createdAt is number;
    }

    // The one shared queue every AI draft (capture triage, Secretary chat,
    // weekly-meeting import) writes into -- never applied to kinds/items
    // directly. `patch` is intentionally loose (a map of whatever fields
    // the draft proposes); it's only ever committed client-side after a
    // human approves it, same discipline the prior rework's captures used.
    function isValidPendingOperation(d) {
      return d.opType in pendingOpTypeValues() &&
        (!('targetId' in d) || d.targetId == null || d.targetId is string) &&
        d.patch is map &&
        (!('sourceCaptureId' in d) || d.sourceCaptureId == null || d.sourceCaptureId is string) &&
        d.sourceType in ['capture', 'chat', 'weekly-import'] &&
        d.status in pendingOpStatusValues() &&
        d.createdAt is number;
    }

    // Secretary chat history -- kept lightweight (role/text/timestamp + an
    // optional link to the pendingOperation it generated), not full LLM
    // request/response payloads.
    function isValidChatMessage(d) {
      return d.role in ['user', 'assistant'] &&
        d.text is string &&
        d.at is number &&
        (!('pendingOperationId' in d) || d.pendingOperationId == null || d.pendingOperationId is string);
    }

    // config/domains, config/resources, config/practiceCategories hold the
    // editable copies of DEFAULT_DOMAINS/DEFAULT_RESOURCES/
    // DEFAULT_PRACTICE_CATEGORIES from src/constants.js -- Settings/
    // Workspace can rewrite any of them without a code change.
    function isValidConfig(d) {
      return d.entries is list;
    }

    match /kinds/{id} {
      allow read: if isAllowed();
      allow delete: if isAllowed();
      allow create, update: if isAllowed() && isValidKind(request.resource.data);
    }

    match /items/{id} {
      allow read: if isAllowed();
      allow delete: if isAllowed();
      allow create, update: if isAllowed() && isValidItem(request.resource.data);
    }

    match /practiceHabits/{id} {
      allow read: if isAllowed();
      allow delete: if isAllowed();
      allow create, update: if isAllowed() && isValidPracticeHabit(request.resource.data);
    }

    match /disciplines/{id} {
      allow read: if isAllowed();
      allow delete: if isAllowed();
      allow create, update: if isAllowed() && isValidDiscipline(request.resource.data);
    }

    match /events/{id} {
      allow read: if isAllowed();
      allow create: if isAllowed() && isValidEvent(request.resource.data);
    }

    match /captures/{id} {
      allow read: if isAllowed();
      allow delete: if isAllowed();
      allow create, update: if isAllowed() && isValidCapture(request.resource.data);
    }

    match /pendingOperations/{id} {
      allow read: if isAllowed();
      allow delete: if isAllowed();
      allow create, update: if isAllowed() && isValidPendingOperation(request.resource.data);
    }

    match /secretaryChat/{id} {
      allow read: if isAllowed();
      allow delete: if isAllowed();
      allow create, update: if isAllowed() && isValidChatMessage(request.resource.data);
    }

    match /config/{id} {
      allow read: if isAllowed();
      allow create, update: if isAllowed() && isValidConfig(request.resource.data);
    }
  }
}
